# Copy this file to .env and fill in real values.
# See documentation.md -> "Environment Variables" and "Transferring to the client's Supabase project"

# Supabase project settings (Project Settings -> API in the Supabase dashboard)
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=PASTE_YOUR_SUPABASE_ANON_KEY_HERE

# Razorpay publishable key ID (safe for the browser — NOT the secret key)
VITE_RAZORPAY_KEY_ID=PASTE_YOUR_RAZORPAY_KEY_ID_HERE

# Store WhatsApp number used to build wa.me links, digits only with country code, e.g. 919876543210
VITE_STORE_WHATSAPP_NUMBER=91XXXXXXXXXX

# ---------------------------------------------------------------------------
# The values below are NEVER used in the frontend. They are set as Supabase
# Edge Function secrets only, via:
#   supabase secrets set RAZORPAY_KEY_SECRET=xxx RAZORPAY_KEY_ID=xxx RESEND_API_KEY=xxx
# Listed here just so you know every secret the project needs.
# ---------------------------------------------------------------------------
# SUPABASE_SERVICE_ROLE_KEY=... (Edge Functions only, auto-injected by Supabase runtime)
# RAZORPAY_KEY_ID=...
# RAZORPAY_KEY_SECRET=...
# RESEND_API_KEY=...
# RESEND_FROM_EMAIL=orders@yourdomain.com
